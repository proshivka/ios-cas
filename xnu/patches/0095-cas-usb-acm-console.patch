 static void
+usb_write(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	(void)usb_rd(base, offset);
+}
