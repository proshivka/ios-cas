+/* Only the USB event thread owns serial TX. Each packet is short at HS. */
+static void
+ud_serial_tx(void)
+{
+	if (!ud.serial || !ud.configured || ud.tx_busy || ud.serial_fault) {
+		return;
+	}
+	uint64_t next = ud.serial_pos;
+	uint32_t len = sweet_log_copy(&next, (char *)(ud.dma + UD_TX), 511);
+	if (!len) {
+		return;
+	}
+	ud.serial_pending_pos = next;
+	ud.tx_busy = true;
+	if (ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL) != 0) {
+		ud.tx_busy = false;
+		ud.serial_fault = true;
+		printf("SWEET USB: ACM TX command failed; console retained in RAM\n");
+	}
