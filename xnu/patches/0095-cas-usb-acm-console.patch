+/* Linux dwc3-qcom USB2-only muxing; no SS PHY or PMIC register access. */
+static bool
+ud_prepare_wrapper(vm_offset_t qs)
+{
+	if (usb_board->cas) {
+		usb_write(qs, QSCRATCH_GENERAL_CFG, usb_rd(qs, QSCRATCH_GENERAL_CFG) | PIPE_UTMI_CLK_DIS);
+		delay(100);
+		usb_write(qs, QSCRATCH_GENERAL_CFG, usb_rd(qs, QSCRATCH_GENERAL_CFG) |
+		    PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
+		delay(100);
+		usb_write(qs, QSCRATCH_GENERAL_CFG, usb_rd(qs, QSCRATCH_GENERAL_CFG) & ~PIPE_UTMI_CLK_DIS);
+		uint32_t general = usb_rd(qs, QSCRATCH_GENERAL_CFG);
+		if ((general & (PIPE_UTMI_CLK_DIS | PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW)) !=
+		    (PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW)) {
+			printf("SWEET USB: CAS UTMI clock selection failed 0x%08x\n", general);
+			return false;
+		}
+		/* Explicit peripheral mode and the CAS DTS's USB2 no-suspend quirks. */
+		dwc_wr(GCTL, (dwc_rd(GCTL) & ~(3u << 12)) | (2u << 12) | 1u);
+		dwc_wr(0xc200, dwc_rd(0xc200) & ~((1u << 6) | (1u << 8)));
+	}
+	if (!usb_board->cas) {
+		usb_write(qs, QSCRATCH_SS_PHY_CTRL, usb_rd(qs, QSCRATCH_SS_PHY_CTRL) | LANE0_PWR_PRESENT);
+	}
+	usb_write(qs, QSCRATCH_HS_PHY_CTRL, usb_rd(qs, QSCRATCH_HS_PHY_CTRL) |
+	    UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL);
+	printf("SWEET USB: wrapper GENERAL 0x%08x HS 0x%08x SS 0x%08x\n",
+	    usb_rd(qs, QSCRATCH_GENERAL_CFG), usb_rd(qs, QSCRATCH_HS_PHY_CTRL), usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
+	return true;
+}
