diff --git a/osfmk/kern/startup.c b/osfmk/kern/startup.c
--- a/osfmk/kern/startup.c
+++ b/osfmk/kern/startup.c
@@ -653,6 +653,7 @@
 #if MACH_KDP
 	kernel_bootstrap_log("kdp_init");
 	kdp_init();
+	printf("SWEETB 1 kdp_init-done\n");
 #endif
 
 #if ALTERNATE_DEBUGGER
@@ -685,8 +686,10 @@
 	vm_kernel_addrhash_salt_ext = early_random();
 
 #ifdef  IOKIT
+	printf("SWEETB 2 PE_init_iokit-in\n");
 	kernel_bootstrap_log("PE_init_iokit");
 	PE_init_iokit();
+	printf("SWEETB 3 PE_init_iokit-done\n");
 #endif
 
 	assert(ml_get_interrupts_enabled() == FALSE);
@@ -787,7 +790,9 @@
 	 *	Start the user bootstrap.
 	 */
 #ifdef  MACH_BSD
+	printf("SWEETB 4 calling-bsd_init\n");
 	bsd_init();
+	printf("SWEETB 5 bsd_init-returned\n");
 #endif
 
 
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -569,6 +569,7 @@
 	 * Initialize the MAC Framework
 	 */
 	mac_policy_initbsd();
+	printf("SWEETI 11 mac_policy_initbsd-done\n");
 
 #if defined (__i386__) || defined (__x86_64__)
 	/*
@@ -680,17 +681,22 @@
 	 *		the kernel task.
 	 */
 	bsd_init_kprintf("calling bsd_bufferinit\n");
+	printf("SWEETI 12 bufferinit-in\n");
 	bsd_bufferinit();
+	printf("SWEETI 13 bufferinit-done\n");
 
