 	knote_init();
+	printf("SWEETI 18 knote_init-done\n");
 
 	/* Initialize event handler */
 	bsd_init_kprintf("calling eventhandler_init\n");
@@ -740,6 +748,7 @@
 	/* Initialize for async IO */
 	bsd_init_kprintf("calling aio_init\n");
 	aio_init();
+	printf("SWEETI 19 aio_init-done\n");
 
 	pthread_init();
 	/* POSIX Shm and Sem */
@@ -760,9 +769,12 @@
 #endif /* NETWORKING */
 #if SOCKETS
 	bsd_init_kprintf("calling socketinit\n");
+	printf("SWEETI 20 socketinit-in\n");
 	socketinit();
+	printf("SWEETI 21 socketinit-done\n");
 	bsd_init_kprintf("calling domaininit\n");
 	domaininit();
+	printf("SWEETI 22 domaininit-done\n");
 	iptap_init();
 #if FLOW_DIVERT
 	flow_divert_init();
@@ -771,6 +783,7 @@
 #if SKYWALK
 	bsd_init_kprintf("calling skywalk_init\n");
 	(void) skywalk_init();
+	printf("SWEETI 23 skywalk_init-done\n");
 #endif /* SKYWALK */
 #if NETWORKING
 #if NECP
@@ -793,10 +806,13 @@
 	/* Initialize kernel memory status notifications */
