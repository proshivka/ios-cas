+static void
+sweet_pstore_init(void)
+{
+	DTEntry entry;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	uint32_t on = 0;
+	PE_parse_boot_argn("sweetpstore", &on, sizeof(on));
+	if (on != 1 || sweet_pstore_reserved_bytes() != SWEET_PSTORE_RESERVED ||
+	    SecureDTLookupEntry(NULL, "/sweet-pstore", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size != 2 * sizeof(*reg) || reg[0] != SWEET_PSTORE_PA ||
+	    reg[1] != SWEET_PSTORE_BYTES ||
+	    !os_atomic_cmpxchg(&sweet_pstore_state, 0, 1, acquire)) {
+		return;
+	}
+	/* Use the existing WB aperture; avoid a conflicting IO-map cache alias. */
+	vm_offset_t mapped = sweet_pstore_address();
+	if (!mapped) {
+		os_atomic_store(&sweet_pstore_state, 0, release);
+		return;
+	}
+	sweet_pstore_header = (volatile struct sweet_pstore_header *)mapped;
+	sweet_pstore_data = (volatile uint8_t *)(mapped + sizeof(*sweet_pstore_header));
+	sweet_pstore_header->signature = 0;
+	sweet_pstore_header->start = 0;
+	sweet_pstore_header->size = 0;
+	clean_dcache64((addr64_t)SWEET_PSTORE_PA, sizeof(*sweet_pstore_header), TRUE);
+	__builtin_arm_dsb(0xf);
+	sweet_pstore_header->signature = SWEET_PSTORE_SIG;
+	clean_dcache64((addr64_t)SWEET_PSTORE_PA, sizeof(*sweet_pstore_header), TRUE);
+	__builtin_arm_dsb(0xf);
+	os_atomic_store(&sweet_pstore_state, 2, release);
+	static const char banner[] = "SWEET PSTORE: Linux pmsg RAM mirror v1, UFS-independent\n";
+	sweet_pstore_append(banner, sizeof(banner) - 1);
+}
+
+void
+sweet_pstore_note(const char *event, uint64_t a, uint64_t b)
+{
+	if (os_atomic_load(&sweet_pstore_state, acquire) != 2 ||
+	    !os_atomic_load(&sweet_pstore_late, relaxed)) {
+		return;
+	}
+	bool critical = !strcmp(event, "timer-in") || !strcmp(event, "timer-out") ||
+	    !strcmp(event, "poll-spin") || !strcmp(event, "timeout");
+	uint32_t _Atomic *budget = critical ? &sweet_pstore_critical_notes : &sweet_pstore_notes;
+	uint32_t limit = critical ? SWEET_PSTORE_CRITICAL_NOTES : SWEET_PSTORE_NOTES;
+	if (os_atomic_load(budget, relaxed) >= limit || os_atomic_inc_orig(budget, relaxed) >= limit) {
+		return;
+	}
+	uint64_t vct, ctl, tval, cval, daif;
+	__asm__ volatile("mrs %0, cntvct_el0" : "=r"(vct));
+	__asm__ volatile("mrs %0, cntv_ctl_el0" : "=r"(ctl));
+	__asm__ volatile("mrs %0, cntv_tval_el0" : "=r"(tval));
+	__asm__ volatile("mrs %0, cntv_cval_el0" : "=r"(cval));
+	__asm__ volatile("mrs %0, daif" : "=r"(daif));
+	char line[384];
+	int count = snprintf(line, sizeof(line),
+	    "PST %s a 0x%llx b 0x%llx clock %llu vct %llu ctl 0x%llx tval %d cval %llu daif 0x%llx pop %llu drop %u\n",
+	    event, (unsigned long long)a, (unsigned long long)b,
+	    (unsigned long long)mach_absolute_time(), (unsigned long long)vct,
+	    (unsigned long long)ctl, (int32_t)tval, (unsigned long long)cval,
+	    (unsigned long long)daif, (unsigned long long)sweet_pstore_rtc_pop(),
+	    os_atomic_load(&sweet_pstore_dropped, relaxed));
+	if (count > 0) {
+		sweet_pstore_append(line, (uint32_t)MIN(count, (int)sizeof(line) - 1));
+	}
+}
+
+static bool
+sweet_pstore_poll_enabled(void)
+{
+	return os_atomic_load(&sweet_pstore_state, acquire) == 2 &&
+	       os_atomic_load(&sweet_pstore_late, relaxed) != 0;
+}
+
+bool
+sweet_pstore_irq_sample(void)
+{
+	if (os_atomic_load(&sweet_pstore_state, acquire) != 2 ||
+	    !os_atomic_load(&sweet_pstore_late, relaxed) ||
+	    os_atomic_load(&sweet_pstore_irqs, relaxed) >= 4096) {
+		return false;
+	}
+	uint32_t irq = os_atomic_inc_orig(&sweet_pstore_irqs, relaxed) + 1;
+	return irq <= 8 || (irq <= 4096 && irq % 64 == 0);
+}
+
+static void
+sweet_pstore_exec(const char *name)
+{
+	if (name != NULL && os_atomic_load(&sweet_pstore_state, acquire) == 2 &&
+	    (!strcmp(name, "dirs_cleaner") || !strcmp(name, "xpcroleaccountd") ||
+	    !strcmp(name, "init_featureflags"))) {
+		os_atomic_store(&sweet_pstore_late, 1, release);
+		sweet_pstore_note(name, 0, 0);
+	}
+}
