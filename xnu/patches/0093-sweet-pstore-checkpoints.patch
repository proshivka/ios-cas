+static void
+sweet_pstore_append_chunk(const char *text, uint32_t count)
+{
+	if (!count || os_atomic_load(&sweet_pstore_state, acquire) != 2) {
+		return;
+	}
+	boolean_t irq = ml_set_interrupts_enabled(FALSE);
+	if (!os_atomic_cmpxchg(&sweet_pstore_busy, 0, 1, acquire)) {
+		os_atomic_inc(&sweet_pstore_dropped, relaxed);
+		ml_set_interrupts_enabled(irq);
+		return; /* Never wait from an interrupt or a console callback. */
+	}
+	uint32_t start = sweet_pstore_at;
+	for (uint32_t i = 0; i < count; i++) {
+		sweet_pstore_data[sweet_pstore_at] = (uint8_t)text[i];
+		if (++sweet_pstore_at == SWEET_PSTORE_CAPACITY) {
+			sweet_pstore_at = 0;
+		}
+	}
+	sweet_pstore_used = MIN(SWEET_PSTORE_CAPACITY, sweet_pstore_used + count);
+	uint32_t first = MIN(count, SWEET_PSTORE_CAPACITY - start);
+	clean_dcache64((addr64_t)(SWEET_PSTORE_PA + 12 + start), first, TRUE);
+	if (count > first) {
+		clean_dcache64((addr64_t)(SWEET_PSTORE_PA + 12), count - first, TRUE);
+	}
+	__builtin_arm_dsb(0xf);
+	sweet_pstore_header->size = sweet_pstore_used;
+	sweet_pstore_header->start = sweet_pstore_at;
+	clean_dcache64((addr64_t)SWEET_PSTORE_PA, sizeof(*sweet_pstore_header), TRUE);
+	__builtin_arm_dsb(0xf);
+	os_atomic_store(&sweet_pstore_busy, 0, release);
+	ml_set_interrupts_enabled(irq);
+}
+
+static void
+sweet_pstore_append(const char *text, uint32_t count)
+{
+	if (!count || os_atomic_load(&sweet_pstore_state, acquire) != 2) {
+		return;
+	}
+	if (count > SWEET_PSTORE_CAPACITY) {
+		text += count - SWEET_PSTORE_CAPACITY;
+		count = SWEET_PSTORE_CAPACITY;
+	}
+	/* An already masked caller gets one bounded chunk; normal callers restore
+	 * their interrupt state between chunks rather than masking a 2 MiB copy. */
+	if (!ml_get_interrupts_enabled() && count > SWEET_PSTORE_CHUNK) {
+		count = SWEET_PSTORE_CHUNK;
+		os_atomic_inc(&sweet_pstore_dropped, relaxed);
+	}
+	while (count) {
+		uint32_t chunk = MIN(count, SWEET_PSTORE_CHUNK);
+		sweet_pstore_append_chunk(text, chunk);
+		text += chunk;
+		count -= chunk;
+	}
+}
