+/* Optional CAS pmsg mirror: volatile reserved RAM, no UFS or sleeping lock. */
+#define SWEET_PSTORE_PA       0xb0200000ULL
+#define SWEET_PSTORE_BYTES    0x200000u
+#define SWEET_PSTORE_RESERVED 0x400000u
+#define SWEET_PSTORE_SIG      0x43474244u /* Linux persistent_ram, sig argument 0. */
+#define SWEET_PSTORE_CAPACITY (SWEET_PSTORE_BYTES - 12u)
+#define SWEET_PSTORE_NOTES    256u
+#define SWEET_PSTORE_CRITICAL_NOTES 192u
+#define SWEET_PSTORE_CHUNK    384u
