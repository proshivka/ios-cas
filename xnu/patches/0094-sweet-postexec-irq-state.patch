+	    os_atomic_load(&sweet_postexec_irqs, relaxed) >= SWEET_POSTEXEC_IRQ_LAST) {
+		return 0;
+	}
+	uint32_t ordinal = os_atomic_inc_orig(&sweet_postexec_irqs, relaxed) + 1;
+	return ordinal <= SWEET_POSTEXEC_IRQ_FIRST ||
+	       (ordinal <= SWEET_POSTEXEC_IRQ_LAST && ordinal % 64 == 0) ? ordinal : 0;
+}
