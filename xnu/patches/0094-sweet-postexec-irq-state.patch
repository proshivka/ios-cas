+	os_atomic_store(&sweet_postexec_wait_deadline, deadline, relaxed);
+	os_atomic_store(&sweet_postexec_wait_result, (uint32_t)result, relaxed);
+	os_atomic_store(&sweet_postexec_wait_stage, stage, release);
+	ml_set_interrupts_enabled(irq);
