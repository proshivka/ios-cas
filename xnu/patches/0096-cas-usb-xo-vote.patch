+/* SM8250's GCC_USB3_SEC_CLKREF_EN feeds both USB instances, including HS. */
+static bool
+usb_cas_enable_xo(vm_offset_t gcc, uint32_t *state)
+{
+	if (usb_board == NULL || !usb_board->cas || usb_board->cbcr[6] != 0x8c010) {
+		return false;
+	}
+	uint32_t off = usb_board->cbcr[6];
+	uint32_t before = usb_rd(gcc, off);
+	bool acquired = !(before & CBCR_CLK_ENABLE);
+	if (acquired) {
+		usb_write(gcc, off, before | CBCR_CLK_ENABLE);
+	}
+	for (unsigned waited = 0; waited < 1000; waited++) {
+		*state = usb_rd(gcc, off);
+		if ((*state & CBCR_CLK_ENABLE) && !(*state & CBCR_CLK_OFF)) {
+			printf("SWEET USB: CAS XO vote 0x%08x -> 0x%08x after %u us\n",
+			    before, *state, waited);
+			return true;
+		}
+		delay(1);
+	}
+	/* Release only the enable bit we acquired; preserve current other bits. */
+	if (acquired) {
+		usb_write(gcc, off, usb_rd(gcc, off) & ~CBCR_CLK_ENABLE);
+	}
+	*state = usb_rd(gcc, off);
+	printf("SWEET USB: CAS XO vote timeout after 1000 us, before 0x%08x now 0x%08x\n",
+	    before, *state);
+	return false;
+}
