diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -54,6 +54,24 @@
 extern void sweet_touch_init(void);
 extern void sweet_usb_probe(void);
 
+/*
+ * SWEET_0082 bring-up marks: one 32x32 square per checkpoint, laid along the
+ * bottom edge of the panel and never erased. On cas nothing else survives a
+ * dead boot - the console ring is ~18 KiB, UFS is not up, there is no UART -
+ * so the colours left on screen are the whole diagnostic channel.
+ * Defined at the end of this file.
+ */
+void sweet_ufs_beacon(unsigned int stage, unsigned int color);
+void sweet_log_start_early(void);
+
+#define SWEET_MARK_BSDINIT      0       /* IOFindBSDRoot entered */
+#define SWEET_MARK_UFS_ENTER    1       /* sweet_ufs_init entered */
+#define SWEET_MARK_HOST_FAIL    2       /* ufs_take_over_host() failed */
+#define SWEET_MARK_HOST_OK      3       /* request list accepted */
+#define SWEET_MARK_PART_OK      4       /* GPT parsed, partition known */
+#define SWEET_MARK_LOG_START    5       /* log flush thread is running */
+#define SWEET_MARK_ROOTDEV      6       /* sweet_ufs_rootdev() reached */
+
 #define REG_CAP         0x00
 #define REG_IS          0x20
 #define REG_IE          0x24
@@ -599,6 +617,8 @@
 		return ENXIO;
 	}
 	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	/* 1: green - the UFS driver is being entered at all. */
+	sweet_ufs_beacon(SWEET_MARK_UFS_ENTER, 0xff00cc00u);
 	uint32_t rw = 0;
 	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
 	uint32_t cache = 0, wait = 0;
@@ -623,6 +643,9 @@
 
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_take_over_host();
+	/* 3: blue - the host took our request list; 2: red - it did not. */
+	sweet_ufs_beacon(error ? SWEET_MARK_HOST_FAIL : SWEET_MARK_HOST_OK,
+	    error ? 0xffcc0000u : 0xff0000ccu);
 	if (!error) {
 		static const uint8_t tur[6] = { 0x00 };
 		/* The first command after the bootloader may report a unit attention. */
@@ -632,6 +655,10 @@
 	if (!error) {
 		error = ufs_find_partition(want);
 	}
+	if (!error) {
+		/* 4: yellow - GPT parsed, the named partition is known. */
+		sweet_ufs_beacon(SWEET_MARK_PART_OK, 0xffcccc00u);
+	}
 	lck_mtx_unlock(&sweet_ufs_lock);
 	if (error) {
 		return error;
@@ -805,12 +832,96 @@
 	}
 }
 
+/*
+ * SWEET_0082: start the persistent log without IOKit and without a root
+ * device.
+ *
+ * sweet_log_start() only runs once IOFindBSDRoot has chosen the partition as
+ * the root, and a bring-up kernel normally dies before that - which is why the
+ * 4 MiB ring in userdata kept coming back as zeros. This path maps the UFS
+ * block and starts the flush thread as early as BSD init, so whatever the
+ * kernel prints from here on reaches the ring.
+ */
+static uint32_t sweet_log_early;
+
+void
+sweet_log_start_early(void)
+{
+	uint32_t on = 1;
+	char want[64] = "userdata";
+	thread_t thread;
+
+	PE_parse_boot_argn("sweetlog", &on, sizeof(on));
+	if (!on || __atomic_load_n(&sweet_log_early, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	/*
+	 * sweet_ufs_init() normally owns the host already; if it has not run (o
+	 * failed further down), do the minimum needed to find the partition.
+	 */
+	if (!su.ready) {
+		DTEntry node;
+		uintptr_t const *reg = NULL;
+		unsigned int size = 0;
+		ppnum_t pn;
+
+		if (SecureDTLookupEntry(NULL, "/sweet-ufs", &node) != kSuccess ||
+		    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+		    size < 2 * sizeof(uintptr_t)) {
+			printf("SWEET LOG: no /sweet-ufs node, early log off\n");
+			return;
+		}
+		su.regs = ml_io_map(reg[0], reg[1]);
+		if (su.regs == NULL) {
+			return;
+		}
+		if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return;
+		}
+		pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+		if (!pn) {
+			return;
+		}
+		su.dma_pa = ptoa_64(pn);
+		su.lun = 0;
+		su.secsize = DEV_BSIZE;
+		lck_mtx_lock(&sweet_ufs_lock);
+		if (ufs_take_over_host() == 0) {
+			(void)ufs_find_partition(want);
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+	}
+	if (!su.writable || su.nblocks < 2 * SWEET_LOG_BLOCKS) {
+		printf("SWEET LOG: no writable area on \\"%s\\", early log off\n", want);
+		return;
+	}
+	/*
+	 * Another root device may already own the bdevsw slot; the log needs none
+	 * of it, but the block helpers do need the driver registered.
+	 */
+	su.bmajor = bdevsw_add(-1, &sweet_ufs_bdevsw);
+	su.cmajor = cdevsw_add_with_bdev(-1, &sweet_ufs_cdevsw, su.bmajor);
+	su.ready = true;
+	if (kernel_thread_start(sweet_log_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("SWEET LOG: cannot start the flush thread\n");
+		return;
+	}
+	thread_deallocate(thread);
+	__atomic_store_n(&sweet_log_early, 1, __ATOMIC_RELEASE);
+	/* 5: cyan - the log flush thread is running. */
+	sweet_ufs_beacon(SWEET_MARK_LOG_START, 0xff00ccccu);
+}
+
 /* Root device for rd=ufsroot0 (IOFindBSDRoot). */
 int sweet_ufs_rootdev(dev_t *dev);
 
 int
 sweet_ufs_rootdev(dev_t *dev)
 {
+	/* 6: magenta - IOFindBSDRoot asked us for the root device. */
+	sweet_ufs_beacon(SWEET_MARK_ROOTDEV, 0xffcc00ccu);
 	if (!su.ready) {
 		int error = sweet_ufs_init();
 		if (error) {
@@ -820,4 +931,43 @@
 	*dev = su.bdev;
 	return 0;
 }
+
+/*
+ * SWEET_0082 bring-up mark: a 32x32 square at (8 + stage * 40, 2300).
+ *
+ * Needs no console, no UFS, no IOKit and nothing is ever cleared, so after the
+ * device gives up the row of colours is the only record of how far it got.
+ */
+void
+sweet_ufs_beacon(unsigned int stage, unsigned int color)
+{
+	static volatile unsigned int *fb;
+	unsigned int x0, y0, x, y;
+
+	if (fb == NULL) {
+		DTEntry node;
+		uintptr_t const *reg = NULL;
+		unsigned int size = 0;
+
+		if (SecureDTLookupEntry(NULL, "/sweet-fbcon", &node) != kSuccess ||
+		    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+		    size < 2 * sizeof(uintptr_t)) {
+			return;
+		}
+		fb = (volatile unsigned int *)ml_io_map(reg[0], reg[1]);
+		if (fb == NULL) {
+			return;
+		}
+	}
+	x0 = 8 + stage * 40;
+	y0 = 2340 - 40;
+	for (y = y0; y < y0 + 32; y++) {
+		volatile unsigned int *line = fb + y * 1080 + x0;
+		for (x = 0; x < 32; x++) {
+			line[x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
